    {
      "schema": "snap.production-strategy/v1",
      "id": "dialogue-director",
      "version": "1.0.0",
      "name": "Dialogue Director",
      "summary": "Speaker-aware voices, deliberate coverage and same-camera versus new-angle continuity; no automatic camera cut on each spoken line.",
      "status": "ready",
      "extends": "pack:script-to-film@1.0.0",
      "parameters": {
        "coverage": "cinematic",
        "continuation": "auto"
      },
      "skills": [
        "snap-voice",
        "snap-location"
      ],
      "stages": [
        {
          "id": "voices",
          "kind": "voices",
          "after": [
            "assets"
          ]
        },
        {
          "id": "location",
          "kind": "location",
          "after": [
            "voices"
          ]
        },
        {
          "id": "coverage",
          "kind": "coverage",
          "after": [
            "location"
          ],
          "guidance": "Choose two-shot, reverse, reaction and insert coverage for intention, not a formula. Keep eyelines consistent; never infer calibrated geometry from a camera label."
        }
      ]
    },
