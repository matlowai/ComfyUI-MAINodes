# Snap gate config: copy to tests/snap/.env (git ignores it) or point SNAP_TEST_ENV at your copy; run_all.sh sources it.
# Absolute paths. Nothing here may point into the repo: results, screenshots and fixtures live in local data folders.

# the CPU ComfyUI the suites drive (privacy on: its base has user/snap_privacy.json {"on": true}) and its base directory
SNAP_TEST_PORT=8195
SNAP_TEST_BASE=/path/to/snapbase
SNAP_TEST_UNIT=snap-test-cpu
# the fresh, empty CPU ComfyUI (no user data, empty models; onboarding, kits, the agents' window) and its base directory
SNAP_TEST_FRESH_PORT=8196
SNAP_TEST_FRESH_BASE=/path/to/freshbase
SNAP_TEST_FRESH_UNIT=snap-fresh-cpu

# optional: the GPU unit for the measure suites (test_g1b_id_copy.py, test_g1b_voice.py); skipped when nothing answers
SNAP_TEST_GPU_PORT=8194
# optional: the gatetest pair, snap-gate in front of a --multi-user ComfyUI with privacy on (vault, ratings, gate suites);
# skipped when SNAP_TEST_GATETEST_BASE is empty or the gate does not answer
SNAP_TEST_GATE_PORT=8297
SNAP_TEST_GATETEST_PORT=8199
SNAP_TEST_GATETEST_BASE=
SNAP_TEST_GATETEST_UNIT=snapbox-gatetest-cpu
SNAP_TEST_GATE_UNITS="snapbox-gatetest-gate snapbox-gatetest-off"

# where results (.json), .out/.err files and screenshots go (made if missing)
SNAP_TEST_OUT=/path/to/snaptest_data/out
# the local fixtures folder (layout and checksums in tests/snap/fixtures.json) and the critic's (tests/snap/critic/README.md)
SNAP_TEST_FIXTURES=/path/to/snaptest_data/fixtures
SNAP_CRITIC_FIXTURES=/path/to/critic_fixtures

# the person's real ComfyUI models folder: the gate fails if a test server links into it or anything under its loras
# changes during the run (U90-1); plus any shared test model folders the servers load (extra model paths), ':'-separated
SNAP_TEST_REAL_MODELS=/path/to/ComfyUI/models
SNAP_TEST_MODEL_DIRS=

# tools: playwright's node_modules (NODE_PATH for every node suite), the ComfyUI venv's python, a Chrome for playwright
SNAP_TEST_NODE_PATH=/path/to/node_modules
SNAP_TEST_PYTHON=/path/to/ComfyUI/venv/bin/python
SNAP_TEST_CHROME=/usr/bin/google-chrome
# optional: the pack the servers load when it is not this checkout (default: the repo holding these tests)
SNAP_TEST_PACK=
