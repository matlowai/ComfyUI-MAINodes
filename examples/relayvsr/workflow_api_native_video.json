{
  "1": {
    "class_type": "RelayVSRModelSettings",
    "inputs": {
      "variant": "X4 original (recommended, also for 2x)",
      "lightx2v_root": "auto",
      "model_dir": "auto",
      "python_executable": "auto",
      "execution_mode": "single GPU",
      "gpu_ids": "0",
      "output_scale": "2",
      "compile_model": false,
      "warmup": false,
      "clip_len": 16,
      "queue_size": 4,
      "codec": "libx264",
      "crf": 17,
      "preserve_audio": true,
      "unload_comfy_models": true,
      "quality": "faithful: back-projection + residual 0.85",
      "back_projection": 1.0,
      "residual_gain": 0.85,
      "downscale": "bicubic",
      "vram": "auto (pick by GPU memory)"
    }
  },
  "2": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "REPLACE_WITH_UPLOADED_VIDEO.mp4"
    }
  },
  "3": {
    "class_type": "RelayVSRUpscaleVideo",
    "inputs": {
      "settings": [
        "1",
        0
      ],
      "video": [
        "2",
        0
      ],
      "seed": 42
    }
  },
  "4": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "3",
        0
      ],
      "filename_prefix": "video/relayvsr",
      "format": "auto",
      "codec": "auto"
    }
  }
}